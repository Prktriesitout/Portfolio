# Copy this file to server/.env and fill in the placeholders locally.
# server/.env is gitignored. NEVER put this key in frontend JavaScript.

OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_MODEL=REPLACE_WITH_CURRENT_MODEL_ID
# OPENAI_BASE_URL=

ENVIRONMENT=development
CHAT_ENABLED=true
LOG_LEVEL=INFO

# Comma-separated exact browser origins allowed to call the API.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500,https://prktriesitout.dpdns.org
# Comma-separated Host header values accepted by the API.
ALLOWED_HOSTS=127.0.0.1,localhost
# Only list proxy IPs here if the API is behind a proxy you control.
TRUSTED_PROXY_IPS=

MAX_REQUEST_BYTES=65536
MAX_MESSAGES=12
MAX_MESSAGE_CHARS=2000
MAX_TOTAL_CHARS=8000
MAX_OUTPUT_TOKENS=500
MAX_RESPONSE_CHARS=8000
REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=60
GLOBAL_DAILY_REQUEST_CAP=500
